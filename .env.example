# ===================================
# DATABASE
# ===================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/enterprise_rag
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===================================
# REDIS
# ===================================
REDIS_URL=redis://redis:6379/0

# ===================================
# PINECONE
# ===================================
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_HOST=https://enterprise-rag-i256rqd.svc.aped-4627-b74a.pinecone.io

# ===================================
# STORAGE
# ===================================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
MODEL_CACHE_DIR=./data/models

# ===================================
# ML MODELS
# ===================================
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
LLM_MODEL_NAME=llama3.1:8b

# ===================================
# ML SERVICE URLS
# ===================================
EMBEDDING_SERVICE_URL=http://embedding-service:8001
RERANKER_SERVICE_URL=http://reranker-service:8002
LLM_SERVICE_URL=http://host.docker.internal:11434/v1

# ===================================
# RAG CONFIGURATION
# ===================================
RETRIEVAL_TOP_K=50
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# ===================================
# APPLICATION
# ===================================
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===================================
# FRONTEND
# ===================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================================
# CELERY
# ===================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

